{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/create_stars_pay",
      "dest": "api/index.js"
    },
    {
      "src": "/crypto-webhook",
      "dest": "api/index.js"
    },
    {
      "src": "/get_balance/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/img/star.png",
      "dest": "/star.png"
    },
    {
      "src": "/img/ton.png",
      "dest": "/ton.png"
    },
    {
      "src": "/img/case3.png",
      "dest": "/case3.png"
    },
    {
      "src": "/img/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
