{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/create_stars_pay",
      "dest": "api/index.js"
    },
    {
      "src": "/crypto-webhook",
      "dest": "api/index.js"
    },
    {
      "src": "/get_balance/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
