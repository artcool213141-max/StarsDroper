{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/api/create_stars_pay", "destination": "/api/index.py" },
    { "source": "/api/create_crypto_pay", "destination": "/api/index.py" },
    { "source": "/api/create_pay", "destination": "/api/index.py" },
    { "source": "/api/crypto-webhook", "destination": "/api/index.py" },
    { "source": "/api/stars-webhook", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
